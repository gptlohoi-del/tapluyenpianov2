{
  "name": "tapluyenpiano-v2",
  "version": "2.0.0",
  "private": true,
  "description": "Piano luyện tập MusicXML offline; APK độc lập và module App Hub",
  "type": "module",
  "scripts": {
    "build:web": "esbuild src/ota-entry.js --bundle --platform=browser --format=iife --target=es2020 --outfile=web/native-ota.bundle.js && node scripts/build-web.mjs",
    "build:preview": "node scripts/build-web.mjs",
    "test": "node --test tests/*.test.mjs",
    "cap:add": "npx cap add android",
    "cap:sync": "npx cap sync android"
  },
  "dependencies": {
    "@capacitor/core": "8.5.3",
    "@capacitor/android": "8.5.3",
    "@capgo/capacitor-updater": "8.54.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "esbuild": "0.25.12"
  }
}
